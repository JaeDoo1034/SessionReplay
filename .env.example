# Optional: required only for Analyze with LLM in the viewer.
OPENAI_API_KEY=

# Optional: defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional: Vercel automatically uses /tmp/session-replay.sqlite when this is omitted.
SESSION_REPLAY_DB_PATH=

# Recommended for Vercel/mobile testing: use a Supabase Postgres connection string.
# Use the Supabase Shared Pooler / Transaction mode URL for serverless deployments.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=3
